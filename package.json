{
  "name": "39note",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build && node scripts/verify-pdf-runtime-assets.mjs && node scripts/verify-ocr-runtime-assets.mjs && node scripts/verify-production-recovery-ui.mjs && node scripts/verify-production-performance.mjs",
    "office-worker:verify": "npm run build && npm run office-worker:verify-built",
    "office-worker:verify-built": "node scripts/verify-office-worker-runtime.mjs",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.ts\"",
    "restore-phase-b:native": "node scripts/verify-restore-phase-b-native.mjs",
    "restore-phase-c:native": "node scripts/verify-restore-phase-c-native.mjs",
    "targeted-purge:native": "node scripts/verify-targeted-purge-home-native.mjs",
    "browser-matrix:native": "node scripts/verify-browser-matrix-native.mjs",
    "production-app:native": "node scripts/verify-production-app-native.mjs",
    "production-recovery-ui:verify": "node scripts/verify-production-recovery-ui.mjs",
    "production-performance:verify": "node scripts/verify-production-performance.mjs",
    "sync-worker:build": "npm --prefix sync-worker run build",
    "sync-worker:test": "npm --prefix sync-worker test",
    "sync-worker:typecheck": "npm --prefix sync-worker run typecheck",
    "dictionary:build": "node scripts/build-wordnet-shards.mjs",
    "pdf-source-lexicon:build": "node scripts/build-pdf-source-lexicon.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@lexical/history": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tesseract.js-data/eng": "1.0.0",
    "fast-xml-parser": "5.7.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lexical": "^0.49.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reamkit": "1.29.0",
    "tailwindcss": "^4.1.13",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.3.7",
    "wordnet-db": "^3.1.14"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
